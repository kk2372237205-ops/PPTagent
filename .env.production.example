# Both domains must resolve to this server before Caddy can issue HTTPS certificates.
# Keep this as .env.production in production. It lets the Compose template be
# validated with another file without ever committing production secrets.
WZLCF_ENV_FILE=".env.production"
APP_DOMAIN="app.example.com"
ONLYOFFICE_DOMAIN="office.example.com"
ACME_EMAIL="admin@example.com"

# Generate a new random value for production. It must match the ONLYOFFICE container.
ONLYOFFICE_JWT_SECRET="replace-with-a-long-random-secret"

# Employee workspaces and WeChat Open Platform website login.
EMPLOYEE_ORG_SLUG="school"
EMPLOYEE_ORG_NAME="学校名称"
# EMPLOYEE_ORGANIZATIONS_JSON=[{"slug":"school-a","name":"学校 A"},{"slug":"school-b","name":"学校 B"}]
WECHAT_OPEN_APP_ID=""
WECHAT_OPEN_APP_SECRET=""
WECHAT_CALLBACK_ORIGIN="https://app.example.com"
WECHAT_AUTO_APPROVE="0"
WECHAT_PLATFORM_ADMIN_OPENID=""
WECHAT_PLATFORM_ADMIN_UNIONID=""
WECHAT_FIRST_USER_IS_ADMIN="0"

# Optional Enterprise WeChat login for schools that authorize a self-built app.
WECOM_ORG_SLUG="school"
WECOM_ORG_NAME="学校名称"
WECOM_CORP_ID=""
WECOM_AGENT_ID=""
WECOM_SECRET=""
WECOM_CALLBACK_ORIGIN="https://app.example.com"
WECOM_PLATFORM_ADMIN_USERID=""
WECOM_AUTO_APPROVE="0"
# WECOM_ORGANIZATIONS_JSON=[{"slug":"school-a","name":"学校 A","corpId":"","agentId":"","secret":"","platformAdminUserId":"","autoApprove":false}]

# Configure the integrations actually used in production. Keep every secret server-side.
SMS_PROVIDER="aliyun"
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""
ALIYUN_SMS_REGION="cn-hangzhou"
SUPABASE_DATABASE_URL=""
ARK_API_KEY=""
DOUBAO_VISION_MODEL="doubao-seed-2-0-pro-260215"
AI_TEXT_SERVICE_NAME="YZStudio GPT-5.6 Sol"
AI_TEXT_BASE_URL="https://yzstudio.vip"
AI_TEXT_API_KEY=""
AI_TEXT_MODEL="gpt-5.6-sol"
# Optional Generate PPT advanced-mode override. It currently matches the global model.
DECK_ADVANCED_TEXT_MODEL="gpt-5.6-sol"
DECK_ADVANCED_SOURCE_CONCURRENCY="3"
DECK_ADVANCED_PLAN_TIMEOUT_MS="900000"
DECK_ADVANCED_VISUAL_TIMEOUT_MS="180000"
AI_TEXT_API_MODE="chat-completions"
AI_TEXT_PROXY_URL=""
AI_IMAGE_SERVICE_NAME="YZStudio GPT Image 2"
AI_IMAGE_BASE_URL="https://yzstudio.vip"
AI_IMAGE_API_KEY=""
AI_IMAGE_MODEL="gpt-image-2"
AI_IMAGE_SIZE="1536x864"
AI_IMAGE_SUPPORTS_EDITS="0"
AI_IMAGE_PROXY_URL=""
CODIA_API_KEY=""
CODIA_BASE_URL="https://openapi.codia.ai"
TECHSZ_API_KEY=""
DESIGN_AGENT_POLL_MS="2500"
DECK_GENERATION_CONCURRENCY="2"
DECK_ADVANCED_GENERATION_CONCURRENCY="6"
# Advanced Generate PPT only: allow one paid Image2 request to wait up to 10 minutes; timeout does not auto-retry.
DECK_ADVANCED_IMAGE_TIMEOUT_MS="600000"
# Advanced Generate PPT only: palette and deck-style references; content-source images are never reused.
DECK_ADVANCED_REFERENCE_IMAGES="1"
PDFTOPPM_PATH=""
