FROM debian:bookworm-slim

WORKDIR /app

# This is the dependable CPU baseline.  A production GPU image can additionally
# install CUDA Torch + SAM 2 without changing the HTTP contract used by the app.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-opencv \
  && apt-get clean

COPY scripts/component-extractor.py ./scripts/component-extractor.py

ENV COMPONENT_EXTRACTOR_HOST=0.0.0.0
ENV COMPONENT_EXTRACTOR_PORT=8765
EXPOSE 8765
CMD ["python3", "scripts/component-extractor.py"]
