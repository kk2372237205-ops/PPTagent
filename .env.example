DATABASE_URL="file:./dev.db"
DEV_SMS_CODE="123456"
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
TENCENT_SMS_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""
TENCENT_SMS_REGION="ap-guangzhou"
# Employee workspaces
EMPLOYEE_ORG_SLUG="school"
EMPLOYEE_ORG_NAME="学校名称"
# Optional multi-school list. A WeChat identity does not prove school membership;
# each first-time application still requires approval in the admin console.
# EMPLOYEE_ORGANIZATIONS_JSON=[{"slug":"school-a","name":"学校 A"},{"slug":"school-b","name":"学校 B"}]

# Employee WeChat Open Platform website login
WECHAT_OPEN_APP_ID=""
WECHAT_OPEN_APP_SECRET=""
# Production must use the public HTTPS website origin registered in WeChat Open Platform.
WECHAT_CALLBACK_ORIGIN="http://localhost:3000"
# Keep 0 to require approval after a user's first scan.
WECHAT_AUTO_APPROVE="0"
# Bind the owner account by OpenID or UnionID after obtaining it from a real login.
WECHAT_PLATFORM_ADMIN_OPENID=""
WECHAT_PLATFORM_ADMIN_UNIONID=""
# Optional one-time bootstrap. Enable only before the owner scans first, then turn it off.
WECHAT_FIRST_USER_IS_ADMIN="0"
# Local development only. Never enable in production.
WECHAT_DEV_BYPASS="0"

# Optional Enterprise WeChat login. It appears beside ordinary WeChat,
# but stays unavailable until the school's administrator supplies these values.
WECOM_ORG_SLUG="school"
WECOM_ORG_NAME="学校名称"
WECOM_CORP_ID=""
WECOM_AGENT_ID=""
WECOM_SECRET=""
WECOM_CALLBACK_ORIGIN="http://localhost:3000"
WECOM_PLATFORM_ADMIN_USERID=""
WECOM_AUTO_APPROVE="0"
# For multiple schools, each school needs its own Enterprise WeChat app credentials.
# WECOM_ORGANIZATIONS_JSON=[{"slug":"school-a","name":"学校 A","corpId":"","agentId":"","secret":"","platformAdminUserId":"","autoApprove":false}]
# Local development only. Never enable in production.
WECOM_DEV_BYPASS="0"
ARK_API_KEY=""
ARK_IMAGE_MODEL="doubao-seedream-5-0-260128"

# YZStudio text relay. Used by every feature that previously called ChatGPT
# for text, outlines, source analysis or JSON planning.
AI_TEXT_SERVICE_NAME="YZStudio GPT-5.6 Sol"
AI_TEXT_BASE_URL="https://yzstudio.vip"
AI_TEXT_API_KEY=""
AI_TEXT_MODEL="gpt-5.6-sol"
# Optional Generate PPT advanced-mode override. It currently matches the global model.
DECK_ADVANCED_TEXT_MODEL="gpt-5.6-sol"
# Advanced mode reads up to three source files at once. This does not split the final deck plan.
DECK_ADVANCED_SOURCE_CONCURRENCY="3"
# The one GPT-5.6 call that composes all confirmed pages into a unified visual plan.
# Its overall, first-byte and response-body limits all follow this value.
DECK_ADVANCED_PLAN_TIMEOUT_MS="900000"
# Optional GPT visual-evidence indexing timeout; a timeout falls back to local evidence metadata.
DECK_ADVANCED_VISUAL_TIMEOUT_MS="180000"
AI_TEXT_API_MODE="chat-completions"
# Direct relay is the default. Set only when this Node.js process still needs a local proxy.
AI_TEXT_PROXY_URL=""

# YZStudio image relay. Use a different key from AI_TEXT_API_KEY.
AI_IMAGE_SERVICE_NAME="YZStudio GPT Image 2"
AI_IMAGE_BASE_URL="https://yzstudio.vip"
AI_IMAGE_API_KEY=""
AI_IMAGE_MODEL="gpt-image-2"
AI_IMAGE_SIZE="1536x864"
# Keep this global switch off; advanced Generate PPT uses its own verified edits switch below.
AI_IMAGE_SUPPORTS_EDITS="0"
AI_IMAGE_PROXY_URL=""

CODIA_API_KEY=""
CODIA_BASE_URL="https://openapi.codia.ai"
ONLYOFFICE_URL="http://localhost:18080"
ONLYOFFICE_INTERNAL_URL="http://host.docker.internal:18080"
ONLYOFFICE_JWT_SECRET="replace-with-a-long-random-secret"
APP_BASE_URL="http://host.docker.internal:3000"
DECK_GENERATION_CONCURRENCY="2"
DECK_ADVANCED_GENERATION_CONCURRENCY="3"
# Generate PPT only: how often the background script dispatches the next unit of work (ms).
DECK_GENERATION_POLL_MS="1200"
# Generate PPT only: run several tasks at the same time instead of strictly one after another.
# OFF by default so existing behaviour is unchanged. Turn it on with "1" once verified with two
# concurrent tasks: without it a second task waits for the first one to finish rendering every page.
DECK_PARALLEL_RUNS="0"
# Only used when DECK_PARALLEL_RUNS=1: how many tasks may advance at the same time.
DECK_PARALLEL_RUN_LIMIT="3"
# Only used when DECK_PARALLEL_RUNS=1: global cap on simultaneous Image2 calls across ALL tasks.
# Parallel tasks multiply per-task concurrency (3 each), so this is what protects the relay from
# capacity errors such as "No available compatible accounts".
DECK_GLOBAL_IMAGE_CONCURRENCY="5"
# PPT polish only: same idea for the polish worker (it has its own separate process).
PPT_POLISH_PARALLEL_RUNS="0"
PPT_POLISH_PARALLEL_RUN_LIMIT="2"
PPT_POLISH_GLOBAL_IMAGE_CONCURRENCY="3"
PPT_POLISH_POLL_MS="1200"
# Advanced Generate PPT only: allow one paid Image2 request to wait up to 10 minutes; timeout does not auto-retry.
DECK_ADVANCED_IMAGE_TIMEOUT_MS="600000"
# Advanced Generate PPT only: pass palette and deck-style references to Image2. Content-source images are never reused.
DECK_ADVANCED_REFERENCE_IMAGES="1"
# Advanced mode does not run per-page GPT audits or automatic Image2 redraws.
# Poppler's pdftoppm, required by "PPT to PNG" in PPT polish and by PDF visual assets in
# advanced deck generation. ALWAYS set an absolute path: a bare command name resolves against
# the PATH of whoever started the server, and different terminals (or different AI tools)
# carry different PATHs — that is exactly how "spawn pdftoppm ENOENT" happened before.
PDFTOPPM_PATH=""

# Local image-explode service (no new key required)
COMPONENT_EXTRACTOR_URL=http://127.0.0.1:8765
COMPONENT_EXTRACTOR_PORT=8765
COMPONENT_EXTRACTOR_DEVICE=auto
COMPONENT_EXTRACTOR_MAX_PARTS=18
COMPONENT_EXTRACTOR_INPAINT=1
# The service prefers the project-local `.venv-sam3` runtime when it is
# importable, then `.venv-image-gpu`, then system Python. `sam3` only activates
# after its licence, checkpoint/Hugging Face access and CUDA setup have been
# verified; `auto` safely uses OpenCV when SAM3 is not fully ready.
COMPONENT_EXTRACTOR_BACKEND=auto
# Run `npm run components:sam3:setup` after your Hugging Face account is
# approved for https://huggingface.co/facebook/sam3. The script writes the
# downloaded local checkpoint path here. Do not commit real tokens or weights.
SAM3_CHECKPOINT=
SAM3_LOAD_FROM_HF=0
COMPONENT_EXTRACTOR_SAM3_CONFIDENCE=0.35
# Box prompts are the default because PPT parts already have visual boxes.
# Turn on text prompts only after your samples prove it helps.
COMPONENT_EXTRACTOR_SAM3_USE_TEXT=0

# Legal SAM3 fallback: Grounded-SAM2/SAM2. The current product can use the
# vision layer planner as the grounding source, then SAM2 as the mask executor.
# After installing SAM2 and downloading a public SAM2.1 checkpoint, set these.
SAM2_CHECKPOINT=
SAM2_MODEL_CFG=
GROUNDED_SAM2_GROUNDER=vision-boxes
GROUNDED_SAM2_MIN_SCORE=0.0
