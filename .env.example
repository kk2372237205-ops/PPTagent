DATABASE_URL="file:./dev.db"
DEV_SMS_CODE="123456"
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
TENCENT_SMS_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""
TENCENT_SMS_REGION="ap-guangzhou"
INITIAL_ADMIN_PHONE="15875754338"
ARK_API_KEY=""
ARK_IMAGE_MODEL="doubao-seedream-5-0-260128"
CODIA_API_KEY=""
CODIA_BASE_URL="https://api.codia.ai"
ONLYOFFICE_URL="http://localhost:18080"
ONLYOFFICE_INTERNAL_URL="http://host.docker.internal:18080"
ONLYOFFICE_JWT_SECRET="replace-with-a-long-random-secret"
APP_BASE_URL="http://host.docker.internal:3000"
DECK_GENERATION_CONCURRENCY="2"

# Local image-explode service (no new key required)
COMPONENT_EXTRACTOR_URL=http://127.0.0.1:8765
COMPONENT_EXTRACTOR_PORT=8765
COMPONENT_EXTRACTOR_DEVICE=auto
COMPONENT_EXTRACTOR_MAX_PARTS=18
COMPONENT_EXTRACTOR_INPAINT=1
# The service prefers the project-local `.venv-sam3` runtime when it is
# importable, then `.venv-image-gpu`, then system Python. `sam3` only activates
# after its licence, checkpoint/Hugging Face access and CUDA setup have been
# verified; `auto` safely uses OpenCV when SAM3 is not fully ready.
COMPONENT_EXTRACTOR_BACKEND=auto
# Run `npm run components:sam3:setup` after your Hugging Face account is
# approved for https://huggingface.co/facebook/sam3. The script writes the
# downloaded local checkpoint path here. Do not commit real tokens or weights.
SAM3_CHECKPOINT=
SAM3_LOAD_FROM_HF=0
COMPONENT_EXTRACTOR_SAM3_CONFIDENCE=0.35
# Box prompts are the default because PPT parts already have visual boxes.
# Turn on text prompts only after your samples prove it helps.
COMPONENT_EXTRACTOR_SAM3_USE_TEXT=0

# Legal SAM3 fallback: Grounded-SAM2/SAM2. The current product can use the
# vision layer planner as the grounding source, then SAM2 as the mask executor.
# After installing SAM2 and downloading a public SAM2.1 checkpoint, set these.
SAM2_CHECKPOINT=
SAM2_MODEL_CFG=
GROUNDED_SAM2_GROUNDER=vision-boxes
GROUNDED_SAM2_MIN_SCORE=0.0
